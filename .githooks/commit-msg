#!/bin/sh
# commit-msg: reject machine-attribution trailers and fingerprints.
#
# This project records human authorship only. Anything that smells like
# AI/tooling attribution in a commit message is rejected outright.

msg_file="$1"

pattern="(co-authored-by|generated by|generated with|claude|openai|chatgpt|copilot|anthropic|gemini|assisted-by|(^|[^[:alpha:]])ai([^[:alpha:]]|$))"

matches="$(grep -iEn "$pattern" "$msg_file" 2>/dev/null)"
if [ -n "$matches" ]; then
  echo "commit-msg: rejected - commit message contains prohibited attribution text:" >&2
  echo "$matches" | sed 's/^/    /' >&2
  echo "" >&2
  echo "Commit messages in this repository must not contain AI or tooling" >&2
  echo "attribution of any kind. Rewrite the message without it." >&2
  exit 1
fi
exit 0
