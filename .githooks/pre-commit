#!/bin/sh
# pre-commit: enforce the repository's commit identity policy.
#
# Every commit in this repository must be authored AND committed by the
# single project identity below. This is what keeps the history's
# provenance mechanically verifiable instead of conventionally promised.
#
# Identity is resolved the same way git resolves it at commit time:
# explicit environment variables first, then effective configuration
# (which includes one-shot `-c user.email=...` overrides).

expected_email="zaydmulani@gmail.com"

config_email="$(git config user.email || true)"

author_email="${GIT_AUTHOR_EMAIL:-$config_email}"
committer_email="${GIT_COMMITTER_EMAIL:-$config_email}"

fail=0
if [ "$author_email" != "$expected_email" ]; then
  echo "pre-commit: rejected - author email is '$author_email', required: '$expected_email'" >&2
  fail=1
fi
if [ "$committer_email" != "$expected_email" ]; then
  echo "pre-commit: rejected - committer email is '$committer_email', required: '$expected_email'" >&2
  fail=1
fi
if [ "$fail" -ne 0 ]; then
  echo "pre-commit: fix identity with:" >&2
  echo "  git config user.name \"Zayd Mulani\" && git config user.email \"zaydmulani@gmail.com\"" >&2
fi
exit $fail
