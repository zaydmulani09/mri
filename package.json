{
  "name": "mri",
  "version": "0.1.0",
  "description": "Code intelligence engine: extracts symbols and structure from source files.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/extraction/index.js",
